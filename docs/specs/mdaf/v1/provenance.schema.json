{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcan.tionis.dev/schemas/mdaf/v1/provenance.schema.json",
  "title": "MDAF v1 provenance activity graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "activities"],
  "properties": {
    "version": { "const": 1 },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/activity" }
    },
    "redactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/redaction" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" },
        "package_url": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "identifier", "resolution"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 },
        "returned_identifier": { "type": "string" },
        "revision": { "type": "string" },
        "checksum": { "type": "string" },
        "resolution": { "enum": ["pinned", "mutable-alias", "unavailable"] }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "tools", "models", "inputs", "outputs", "depends_on", "parameters", "parameters_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool" } },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "parameters": { "type": "object" },
        "parameters_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "location", "reason"],
      "properties": {
        "member": { "type": "string" },
        "location": { "type": "string" },
        "reason": { "type": "string" },
        "original_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
