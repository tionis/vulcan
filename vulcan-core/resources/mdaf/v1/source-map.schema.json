{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcan.tionis.dev/schemas/mdaf/v1/source-map.schema.json",
  "title": "MDAF v1 source map",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "document_sha256", "coordinate_systems", "mappings", "references"],
  "properties": {
    "version": { "const": 1 },
    "document_sha256": { "$ref": "#/$defs/sha256" },
    "coordinate_systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
    "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_system", "start", "end"],
      "properties": {
        "coordinate_system": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "label_start": { "type": "string" },
        "label_end": { "type": "string" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "unit", "origin"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "origin": { "type": "integer" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "source"],
      "properties": {
        "document": { "$ref": "#/$defs/span" },
        "source": { "$ref": "#/$defs/interval" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "target"],
      "properties": {
        "document": { "$ref": "#/$defs/span" },
        "target": { "$ref": "#/$defs/interval" },
        "kind": { "type": "string" }
      }
    }
  }
}
