{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcan.tionis.dev/schemas/mdaf/v1/source-map.schema.json",
  "title": "MDAF v1 source map",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "document_digest", "mappings", "references"],
  "properties": {
    "version": { "const": 1 },
    "document_digest": { "$ref": "#/$defs/digest" },
    "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selectors"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "selectors": { "type": "array", "items": { "$ref": "#/$defs/selector" } }
      }
    },
    "selector": {
      "oneOf": [
        { "$ref": "#/$defs/interval" },
        { "$ref": "#/$defs/rectangle" },
        { "$ref": "#/$defs/polygon" },
        { "$ref": "#/$defs/grid" },
        { "$ref": "#/$defs/text_quote" },
        { "$ref": "#/$defs/fragment" },
        { "$ref": "#/$defs/extension" }
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "start", "end"],
      "properties": {
        "type": { "const": "interval" },
        "unit": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "type": "number" },
        "label_start": { "type": "string" },
        "label_end": { "type": "string" }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "x", "y", "width", "height"],
      "properties": {
        "type": { "const": "rectangle" },
        "unit": { "type": "string", "minLength": 1 },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "points"],
      "properties": {
        "type": { "const": "polygon" },
        "unit": { "type": "string", "minLength": 1 },
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "row_start", "row_end", "column_start", "column_end"],
      "properties": {
        "type": { "const": "grid" },
        "sheet": { "type": "string" },
        "row_start": { "type": "integer", "minimum": 0 },
        "row_end": { "type": "integer", "minimum": 1 },
        "column_start": { "type": "integer", "minimum": 0 },
        "column_end": { "type": "integer", "minimum": 1 }
      }
    },
    "text_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "exact"],
      "properties": {
        "type": { "const": "text-quote" },
        "exact": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "fragment" },
        "value": { "type": "string", "minLength": 1 },
        "conforms_to": { "type": "string", "minLength": 1 }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "namespace", "data"],
      "properties": {
        "type": { "const": "extension" },
        "namespace": { "type": "string", "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/.+$" },
        "data": true
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "source"],
      "properties": {
        "document": { "$ref": "#/$defs/span" },
        "source": { "$ref": "#/$defs/locator" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "target"],
      "properties": {
        "document": { "$ref": "#/$defs/span" },
        "target": { "$ref": "#/$defs/locator" },
        "kind": { "type": "string" }
      }
    }
  }
}
