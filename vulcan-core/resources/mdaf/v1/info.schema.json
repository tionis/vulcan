{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcan.tionis.dev/schemas/mdaf/v1/info.schema.json",
  "title": "MDAF v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "markdown", "producer", "members", "sources"],
  "properties": {
    "format": { "const": "mdaf" },
    "version": { "const": 1 },
    "title": { "type": "string" },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "media_type"],
      "properties": {
        "path": { "const": "text.md" },
        "digest": { "$ref": "#/$defs/digest" },
        "media_type": { "const": "text/markdown" },
        "variant": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" }
      }
    },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/member" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["source-map", "outline", "native-renditions", "embedded-sources", "environments", "extensions"] },
      "uniqueItems": true
    },
    "derived_from": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "alternate_digest": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:[0-9a-f]+$" },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "media_type", "size", "digest", "created_by"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "provenance", "source-map", "outline", "asset", "rendition", "source", "environment", "extension"] },
        "media_type": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "#/$defs/digest" },
        "created_by": { "type": "string", "minLength": 1 },
        "schema": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "media_type", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "alternate_digests": { "type": "array", "items": { "$ref": "#/$defs/alternate_digest" }, "uniqueItems": true },
        "name": { "type": "string" },
        "embedded_path": { "type": "string" }
      }
    }
  }
}
